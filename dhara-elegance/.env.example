# ============================================================
# Dhara Elegance — Environment Variables
#
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local. NEVER paste real secret values into
# chat, tickets, or screenshots.
#
# Rule of thumb:
#   NEXT_PUBLIC_*  -> shipped to the browser. Public data only.
#   everything else -> server-only. Never import into a
#                      Client Component.
# ============================================================


# ------------------------------------------------------------
# SUPABASE — PUBLIC
# Where to find: Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable / anon key. Safe for the browser: it is
# powerless on its own and is governed entirely by RLS.
# (Newer Supabase projects label this "publishable key";
#  older ones label it "anon public". Either goes here.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ------------------------------------------------------------
# SUPABASE — SECRET  (SERVER ONLY)
# Where to find: Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------

# Service-role key. BYPASSES ALL RLS. Used only by trusted
# server code (webhooks, admin batch jobs, seed scripts).
# If this ever reaches the browser, treat it as a full database
# breach and rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by the Supabase CLI
# for migrations/seeding. Contains your DB password.
# Where to find: Dashboard > Project Settings > Database
SUPABASE_DB_URL=

# Project ref (the subdomain of your Supabase URL). Used by
# `npm run db:types` to generate TypeScript types.
SUPABASE_PROJECT_ID=


# ------------------------------------------------------------
# RAZORPAY
# Where to find: Razorpay Dashboard > Settings > API Keys
# Start in TEST mode. Switch to live keys only in production.
# ------------------------------------------------------------

# Key ID. Technically visible in the checkout payload, but we
# keep it server-side and hand it to the client per-session
# rather than baking it into the bundle.
RAZORPAY_KEY_ID=

# Key secret. SERVER ONLY. Used to create orders and to verify
# payment signatures.
RAZORPAY_KEY_SECRET=

# Webhook signing secret. SERVER ONLY. Set when you create the
# webhook in Razorpay Dashboard > Settings > Webhooks.
# Used to verify that incoming webhook events are genuine.
RAZORPAY_WEBHOOK_SECRET=


# ------------------------------------------------------------
# EMAIL (Resend by default — provider is swappable)
# Where to find: Resend Dashboard > API Keys
# ------------------------------------------------------------

RESEND_API_KEY=

# Verified sender address on your domain.
EMAIL_FROM="Dhara Elegance <orders@dharaelegance.com>"

# Internal address that receives new-order notifications.
ADMIN_NOTIFICATION_EMAIL=


# ------------------------------------------------------------
# WHATSAPP
# ------------------------------------------------------------

# Business number in international format, digits only.
# Example for an Indian number: 919104097343
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=


# ------------------------------------------------------------
# SITE
# ------------------------------------------------------------

# Canonical origin. Used for SEO metadata, sitemap, OG images,
# auth redirect URLs, and Razorpay callbacks.
# Local:      http://localhost:3000
# Production: https://www.dharaelegance.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
